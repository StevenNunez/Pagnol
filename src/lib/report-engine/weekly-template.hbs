<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<style>
  :root{
    --tinta:#1f2937; --suave:#6b7280; --linea:#cbd5e1; --linea2:#94a3b8;
    --barra:#16463a; --barra2:#0f6e56; --acento:#7ab800; --cab:#243746;
    --zebra:#f1f5f4; --valar:#111827;
  }
  *{box-sizing:border-box;}
  body{font-family:Arial,Helvetica,sans-serif;color:var(--tinta);margin:0;font-size:9px;}
  @page{ size:A4 portrait; margin:9mm; }

  .brand{display:flex;align-items:stretch;border:1.5px solid var(--valar);border-radius:4px;overflow:hidden;margin-bottom:6px;}
  .brand .logo{width:130px;display:flex;align-items:center;justify-content:center;border-right:1.5px solid var(--valar);padding:6px;}
  .brand .logo img{max-width:118px;max-height:46px;object-fit:contain;}
  .brand .logo .v{font-weight:800;font-size:26px;letter-spacing:6px;color:var(--valar);line-height:1;text-align:center;}
  .brand .logo .v small{display:block;font-size:9px;letter-spacing:10px;font-weight:700;margin-top:2px;}
  .brand .titulo{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;}
  .brand .titulo h1{margin:0;font-size:16px;letter-spacing:2px;color:var(--barra);}
  .brand .titulo .sub{font-size:8px;color:var(--suave);letter-spacing:3px;margin-top:2px;}
  .brand .sqm{width:130px;display:flex;flex-direction:column;align-items:center;justify-content:center;border-left:1.5px solid var(--valar);padding:6px;}
  .brand .sqm img{max-width:90px;max-height:38px;object-fit:contain;}
  .brand .sqm .b{background:var(--barra2);color:#fff;font-weight:800;font-size:16px;padding:2px 12px;border-radius:3px;letter-spacing:1px;}
  .brand .sqm .pg{font-size:7.5px;color:var(--suave);margin-top:3px;}

  .sec{background:var(--barra);color:#fff;font-weight:700;font-size:9.5px;letter-spacing:1px;padding:4px 8px;border-radius:3px;margin:7px 0 3px;display:flex;justify-content:space-between;}
  .sec .r{color:#bfe3cf;font-weight:600;}
  .meta{display:grid;grid-template-columns:repeat(12,1fr);gap:3px;font-size:8.5px;}
  .f{display:flex;border:0.7px solid var(--linea);border-radius:3px;overflow:hidden;}
  .f .k{background:var(--zebra);color:var(--suave);font-weight:700;padding:3px 5px;white-space:nowrap;}
  .f .val{padding:3px 5px;font-weight:600;flex:1;}

  .kpis{display:flex;gap:8px;margin-top:2px;}
  .kpis .box{flex:1;border:0.7px solid var(--linea);border-radius:4px;padding:7px;text-align:center;}
  .kpis .box .n{font-size:20px;font-weight:800;color:var(--barra2);line-height:1;}
  .kpis .box .k{font-size:7.5px;color:var(--suave);text-transform:uppercase;letter-spacing:.6px;margin-top:3px;}

  table{border-collapse:collapse;width:100%;font-size:8px;}
  th,td{border:0.6px solid var(--linea);padding:3px 4px;text-align:center;}
  thead th{background:var(--cab);color:#fff;font-weight:700;letter-spacing:.3px;}
  tbody tr:nth-child(even){background:var(--zebra);}
  tfoot td{background:var(--zebra);font-weight:800;}
  .txl{text-align:left;}
  .empty{color:var(--suave);font-style:italic;}

  .desc{border:0.7px solid var(--linea);border-radius:3px;padding:5px 7px;min-height:38px;font-size:8.5px;white-space:pre-wrap;}

  .firmas{display:flex;gap:14px;margin-top:18px;}
  .firma{flex:1;text-align:center;}
  .firma .sig{height:34px;object-fit:contain;margin-bottom:-4px;}
  .firma .ln{border-top:1px solid var(--tinta);margin:22px 10px 3px;}
  .firma .ro{font-weight:700;font-size:8.5px;}
  .firma .nm{font-size:8px;color:var(--suave);}
</style>
</head>
<body>

{{#*inline "logoValar"}}
  {{#if logos.valar}}<img src="{{logos.valar}}" alt="VALAR">{{else}}<div class="v">VA<small>VALAR</small></div>{{/if}}
{{/inline}}
{{#*inline "logoSqm"}}
  {{#if logos.sqm}}<img src="{{logos.sqm}}" alt="SQM">{{else}}<div class="b">SQM</div>{{/if}}
{{/inline}}

<div class="brand">
  <div class="logo">{{> logoValar}}</div>
  <div class="titulo"><h1>REPORTE SEMANAL</h1><div class="sub">CONTROL DE OBRA · PAÑOL</div></div>
  <div class="sqm">{{> logoSqm}}<div class="pg">{{meta.desde}} — {{meta.hasta}}</div></div>
</div>

<div class="sec">INFORMACIÓN GENERAL <span class="r">{{meta.tenant}}</span></div>
<div class="meta">
  <div class="f" style="grid-column:span 7"><div class="k">TÍTULO</div><div class="val">{{meta.title}}</div></div>
  <div class="f" style="grid-column:span 5"><div class="k">CLIENTE</div><div class="val">{{meta.client}}</div></div>
  <div class="f" style="grid-column:span 5"><div class="k">FAENA</div><div class="val">{{meta.faena}}</div></div>
  <div class="f" style="grid-column:span 4"><div class="k">OBRA</div><div class="val">{{meta.obra}}</div></div>
  <div class="f" style="grid-column:span 3"><div class="k">CONTRATO</div><div class="val">{{meta.contract}}</div></div>
  <div class="f" style="grid-column:span 4"><div class="k">ÁREA</div><div class="val">{{meta.area}}</div></div>
  <div class="f" style="grid-column:span 4"><div class="k">ESPECIALIDAD</div><div class="val">{{meta.specialty}}</div></div>
  <div class="f" style="grid-column:span 4"><div class="k">SUPERVISOR</div><div class="val">{{meta.supervisor}}</div></div>
  <div class="f" style="grid-column:span 6"><div class="k">DESDE</div><div class="val">{{meta.desde}}</div></div>
  <div class="f" style="grid-column:span 6"><div class="k">HASTA</div><div class="val">{{meta.hasta}}</div></div>
</div>

<div class="sec">RESUMEN DE LA SEMANA</div>
<div class="kpis">
  <div class="box"><div class="n">{{resumen.reportCount}}</div><div class="k">Reportes diarios</div></div>
  <div class="box"><div class="n">{{resumen.otTotal}}</div><div class="k">OT acumuladas</div></div>
  <div class="box"><div class="n">{{resumen.hhTotal}}</div><div class="k">HH totales</div></div>
  <div class="box"><div class="n">{{resumen.workersMax}}</div><div class="k">Dotación máx.</div></div>
</div>

<div class="sec">DETALLE POR DÍA</div>
<table>
  <thead><tr><th class="txl" style="width:90px">Fecha</th><th class="txl">OT principal</th><th style="width:50px">OT</th><th style="width:65px">Personal</th><th style="width:65px">HH</th><th style="width:90px">Estado</th></tr></thead>
  <tbody>
    {{#if dias.length}}
      {{#each dias}}<tr><td class="txl">{{fecha}}</td><td class="txl">{{otNumber}}</td><td>{{otCount}}</td><td>{{workers}}</td><td>{{hh}}</td><td>{{estado}}</td></tr>{{/each}}
    {{else}}<tr><td colspan="6" class="empty">Sin reportes diarios consolidados</td></tr>{{/if}}
  </tbody>
  <tfoot>
    <tr><td class="txl" colspan="2">TOTAL SEMANA</td><td>{{resumen.otTotal}}</td><td>{{resumen.workersMax}}</td><td>{{resumen.hhTotal}}</td><td></td></tr>
  </tfoot>
</table>

<div class="sec">OBSERVACIONES DE LA SEMANA</div>
<div class="desc">{{observaciones}}</div>

<div class="sec">ENTREGA DE TURNO</div>
<div class="desc">{{entregaTurno}}</div>

<div class="firmas">
  <div class="firma">
    {{#if firmas.supervisor.firma}}<img class="sig" src="{{firmas.supervisor.firma}}" alt="firma">{{/if}}
    <div class="ln"></div><div class="ro">{{firmas.supervisor.nombre}}</div><div class="nm">{{firmas.supervisor.cargo}}</div>
  </div>
  <div class="firma">
    {{#if firmas.operaciones.firma}}<img class="sig" src="{{firmas.operaciones.firma}}" alt="firma">{{/if}}
    <div class="ln"></div><div class="ro">{{firmas.operaciones.nombre}}</div><div class="nm">{{firmas.operaciones.cargo}}</div>
  </div>
</div>

</body>
</html>
